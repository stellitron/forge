  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "node scripts/icons.mjs",
    "test": "vitest run && cd src-tauri && cargo test",
    "app": "tauri dev",
    "package": "tauri build",
    "screenshots": "node scripts/screenshots.mjs",
    "check": "npm run version:check && tsc --noEmit && vitest run && cd src-tauri && cargo test && cd .. && vite build",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set"
  },
  "dependencies": {
